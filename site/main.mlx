open Yocaml

let languages =
  [
    ( "ocaml",
      Tm_grammars.ocaml,
      {|type shape = Circle of float | Rect of float * float

(* Area of a shape *)
let area = function
  | Circle r -> Float.pi *. r *. r
  | Rect (w, h) -> w *. h

let () = Printf.printf "%.2f\n" (area (Circle 1.5))|}
    );
    ( "mlx",
      Tm_grammars.mlx,
      {|(* A greeting card component *)
let card ~title ~children () =
  <section class_="card">
    <h2>(JSX.string title)</h2>
    children
  </section>

let page ~name () =
  <card title="Hello">
    <p>(JSX.string ("Welcome, " ^ name))</p>
    <button type_=`button disabled=false>(JSX.string "OK")</button>
  </card>|}
    );
    ( "reason",
      Tm_grammars.reason,
      {|type shape = Circle(float) | Rect(float, float);

/* Area of a shape */
let area = fun
  | Circle(r) => Float.pi *. r *. r
  | Rect(w, h) => w *. h;

Printf.printf("%.2f\n", area(Circle(1.5)));|}
    );
    ( "dune",
      Tm_grammars.dune,
      {|; Build the demo executable
(executable
 (name demo)
 (libraries ochre tm-grammars)
 (preprocess (pps ppx_deriving.show)))|}
    );
    ( "rust",
      Tm_grammars.rust,
      {|enum Shape { Circle(f64), Rect(f64, f64) }

// Area of a shape
fn area(s: &Shape) -> f64 {
    match s {
        Shape::Circle(r) => std::f64::consts::PI * r * r,
        Shape::Rect(w, h) => w * h,
    }
}

fn main() { println!("{:.2}", area(&Shape::Circle(1.5))); }|}
    );
    ( "typescript",
      Tm_grammars.typescript,
      {|type Shape = { kind: "circle"; r: number } | { kind: "rect"; w: number; h: number };

// Area of a shape
const area = (s: Shape): number =>
  s.kind === "circle" ? Math.PI * s.r ** 2 : s.w * s.h;

console.log(area({ kind: "circle", r: 1.5 }).toFixed(2));|}
    );
    ( "python",
      Tm_grammars.python,
      {|from dataclasses import dataclass
import math

@dataclass
class Circle:
    r: float

    def area(self) -> float:
        # Area of a circle
        return math.pi * self.r ** 2

print(f"{Circle(1.5).area():.2f}")|}
    );
    ( "json",
      Tm_grammars.json,
      {|{
  "name": "ochre",
  "version": "1.1.0",
  "themes": ["nord", "gruvbox"],
  "lineNumbers": true,
  "tabSize": 2
}|}
    );
    ( "shellscript",
      Tm_grammars.shellscript,
      {|#!/usr/bin/env bash
set -euo pipefail

# Highlight every OCaml file
for f in src/*.ml; do
  ochre --theme nord --lang ocaml "$f" > "${f%.ml}.html"
done
echo "done: $(ls src/*.html | wc -l) files"|}
    );
    ( "html",
      Tm_grammars.html,
      {|<!-- A greeting card -->
<section class="card" id="greeting">
  <h2>Hello</h2>
  <p>Welcome, <em>friend</em>.</p>
  <button type="button" disabled>OK</button>
</section>

<style>
  section { padding: 1rem; color: #333; }
</style>

<script>
  const card = document.getElementById("greeting");
  card.addEventListener("click", () => console.log(42));
</script>|}
    );
    ( "css",
      Tm_grammars.css,
      {|/* A greeting card */
:root {
  --accent: #c2410c;
}

.card {
  padding: 1rem 2rem;
  border: 1px solid var(--accent);
  font-family: "Georgia", serif;
}

#greeting:hover > h2 {
  color: rgb(0 0 0 / 80%);
}

@media (max-width: 600px) {
  .card { padding: 0.5rem; }
}|}
    );
    ( "javascript",
      Tm_grammars.javascript,
      {|// Area of a shape
class Circle {
  constructor(r) {
    this.r = r;
  }

  get area() {
    return Math.PI * this.r ** 2;
  }
}

const shapes = [new Circle(1.5), new Circle(2)];
for (const s of shapes) {
  console.log(`area: ${s.area.toFixed(2)}`);
}|}
    );
    ( "ruby",
      Tm_grammars.ruby,
      {|# Area of a shape
class Circle
  attr_reader :r

  def initialize(r)
    @r = r
  end

  def area
    Math::PI * r**2
  end
end

shapes = [Circle.new(1.5), Circle.new(2)]
shapes.each { |s| puts "area: #{format('%.2f', s.area)}" }|}
    );
    ( "go",
      Tm_grammars.go,
      {|package main

import (
	"fmt"
	"math"
)

// Area of a shape
type Circle struct {
	R float64
}

func (c Circle) Area() float64 {
	return math.Pi * c.R * c.R
}

func main() {
	shapes := []Circle{{R: 1.5}, {R: 2}}
	for _, s := range shapes {
		fmt.Printf("area: %.2f\n", s.Area())
	}
}|}
    );
  ]

let markdown_root = Path.rel [ "_build"; "default"; "_doc"; "_markdown" ]
let api_dir = Path.(markdown_root / "ochre")
let readme_source = Path.(api_dir / "README.md")
let cli_source = Path.(markdown_root / "ochre-cli" / "cli.md")
let assets_dir = Path.rel [ "site"; "assets" ]
let target_dir = Path.rel [ "docs"; "_site" ]
let target_assets_dir = Path.(target_dir / "assets")
let cache_file = Path.rel [ "docs"; "_cache" ]
let pages_url = "https://davesnx.github.io/ochre/"
let repo_url = "https://github.com/davesnx/ochre"

type section = Guide | Api

type page = {
  source_name : string;
  output_name : string;
  label : string;
  section : section;
  content : [ `Markdown of string | `Html of string ];
}

let highlighter =
  Ochre.load_exn (List.map (fun (lang, json, _) -> (lang, json)) languages)

let themes =
  List.filter_map
    (fun name -> Option.map (fun t -> (name, t)) (Ochre.Theme.find name))
    Ochre.Theme.available_names

(* Theme and grammar names use '-'; the matching OCaml values use '_'. *)
let ocaml_ident name = String.map (function '-' -> '_' | c -> c) name

let basename_exn path =
  match Path.basename path with
  | Some name ->
      name
  | None ->
      invalid_arg ("Expected a basename for path: " ^ Path.to_string path)

(* Odoc also documents the vendored Oniguruma and TmLanguage libraries; only
   the Ochre modules are public API. *)
let is_api_source path =
  let name = basename_exn path in
  Path.has_extension "md" path && String.starts_with ~prefix:"Ochre" name

(* "Ochre-Theme.md" -> "Ochre.Theme": keep the module path visible. *)
let api_label source_name =
  Filename.remove_extension source_name
  |> String.map (function '-' -> '.' | c -> c)

let api_page source_name markdown =
  {
    source_name;
    output_name = Filename.remove_extension source_name ^ ".html";
    label = api_label source_name;
    section = Api;
    content = `Markdown markdown;
  }

let trim_trailing_newlines text =
  let rec last index =
    if index >= 0 && (text.[index] = '\n' || text.[index] = '\r') then
      last (index - 1)
    else
      index
  in
  String.sub text 0 (last (String.length text - 1) + 1)

(* README code blocks follow the site light/dark toggle. *)
let doc_light = Ochre.Theme.light
let doc_dark = ("doc-dark", Ochre.Theme.gruvbox)

let doc_theme_css =
  Printf.sprintf ":root[data-doc-theme=\"dark\"] {\n%s\n}"
    (Ochre.html_theme_css (fst doc_dark))

let lang_of_label label =
  match String.lowercase_ascii (String.trim label) with
  | "bash" | "sh" | "shell" ->
      Some "shellscript"
  | "" ->
      None
  | label when List.exists (fun (lang, _, _) -> lang = label) languages ->
      Some label
  | _ ->
      None

let code_figure ~label ~code () =
  let lang = lang_of_label label in
  let options =
    Ochre.Html_options.make ~pre_class:"doc-code__pre"
      ~code_class:"doc-code__code" ()
  in
  let highlighted =
    Ochre.to_html highlighter ~options ~theme:doc_light
      ~extra_themes:[ doc_dark ]
      ~lang:(Option.value lang ~default:"plaintext")
      (trim_trailing_newlines code)
  in
  <figure class_="doc-code">(JSX.unsafe highlighted)</figure>

(* Markdown links target GitHub paths (README.md, docs/*.md) or odoc pages
   (./Ochre-Theme.md, ./#val-load). On the site they become site pages; other
   repository paths go to GitHub. *)
let resolve_url ~pages ~current ~attr url =
  let has prefix = String.starts_with ~prefix url in
  let drop prefix s =
    if String.starts_with ~prefix s then
      String.sub s (String.length prefix)
        (String.length s - String.length prefix)
    else
      s
  in
  let file, fragment =
    match String.index_opt url '#' with
    | Some i ->
        (String.sub url 0 i, String.sub url i (String.length url - i))
    | None ->
        (url, "")
  in
  (* Odoc markdown has no item anchors; "### load" headings get id="load". *)
  let fragment =
    Str.replace_first
      (Str.regexp "^#\\(val\\|type\\|exception\\|module\\)-")
      "#" fragment
  in
  let file =
    match drop "./" file with
    | "docs/README.md" ->
        "Ochre.md"
    | f ->
        drop "docs/" f
  in
  if has pages_url then
    match drop pages_url url with "" -> "index.html" | path -> path
  else if has "http:" || has "https:" || has "mailto:" then
    url
  else if file = "" then
    current.output_name ^ fragment
  else
    match List.find_opt (fun p -> p.source_name = file) pages with
    | Some page ->
        page.output_name ^ fragment
    | None when attr = "src" ->
        "https://raw.githubusercontent.com/davesnx/ochre/main/" ^ url
    | None ->
        repo_url ^ "/blob/main/" ^ url

let rewrite_urls ~pages ~current html =
  Str.global_substitute
    (Str.regexp {|\(href\|src\)="\([^"]*\)"|})
    (fun s ->
      let attr = Str.matched_group 1 s in
      Printf.sprintf "%s=\"%s\"" attr
        (resolve_url ~pages ~current ~attr (Str.matched_group 2 s))
    )
    html

let markdown_body ~pages ~current markdown =
  markdown |> Omd.of_string
  |> List.filter_map (function
    | Omd.Html_block (_, html) when String.starts_with ~prefix:"<!--" html ->
        None
    | Omd.Code_block (_, label, code) ->
        Some (code_figure ~label ~code ())
    | block ->
        Some (JSX.unsafe (Omd.to_html [ block ]))
    )
  |> JSX.list |> JSX.render
  |> rewrite_urls ~pages ~current

let playground_html =
  let highlight ~lang source =
    Ochre.to_html highlighter
      ~theme:(snd (List.hd themes))
      ~extra_themes:themes ~lang source
  in
  let options items =
    items
    |> List.map (fun value ->
        Printf.sprintf "<option value=%S>%s</option>" value value
    )
    |> String.concat ""
  in
  let block lang html =
    Printf.sprintf "<div class=\"playground__block\" data-lang=%S>%s</div>" lang
      html
  in
  let samples =
    languages
    |> List.map (fun (lang, _, source) -> block lang (highlight ~lang source))
    |> String.concat "\n"
  in
  (* The theme id is only known in the browser, so each snippet is rendered
     with a placeholder identifier that JS fills in. *)
  let placeholder = "theme_placeholder" in
  let snippets =
    languages
    |> List.map (fun (lang, _, _) ->
        let html =
          highlight ~lang:"ocaml"
            (Printf.sprintf
               "let hl = Ochre.load_exn [ (%S, Tm_grammars.%s) ] in\n\
                Ochre.to_html hl ~theme:Ochre.Theme.%s ~lang:%S source"
               lang (ocaml_ident lang) placeholder lang
            )
        in
        match Str.split_delim (Str.regexp_string placeholder) html with
        | [ before; after ] ->
            block lang (before ^ "<span class=\"theme-id\"></span>" ^ after)
        | _ ->
            failwith ("theme placeholder not found exactly once for " ^ lang)
    )
    |> String.concat "\n"
  in
  let theme_css =
    themes
    |> List.map (fun (name, _) ->
        Printf.sprintf ".playground[data-theme=%S] {\n%s\n}" name
          (Ochre.html_theme_css name)
    )
    |> String.concat "\n"
  in
  let theme_ids =
    themes
    |> List.map (fun (name, _) -> Printf.sprintf "%S:%S" name (ocaml_ident name))
    |> String.concat ","
  in
  Printf.sprintf
    {|<style>
%s
</style>
<h1>Playground</h1>
<p>Every built-in theme of <code>Ochre.Theme</code> with grammars from <a href="https://github.com/davesnx/tm-grammars">tm-grammars</a>. Pick a theme and a language; the code below produces the block above.</p>
<div class="playground" id="playground">
<div class="playground__toolbar">
<label>Theme <select id="playground-theme">%s</select></label>
<label>Language <select id="playground-lang">%s</select></label>
</div>
%s
<h2>Code</h2>
%s
</div>
<script>
(function () {
  var themeIds = {%s};
  var root = document.getElementById('playground');
  var theme = document.getElementById('playground-theme');
  var lang = document.getElementById('playground-lang');
  function render() {
    root.dataset.theme = theme.value;
    root.querySelectorAll('.playground__block').forEach(function (b) {
      b.classList.toggle('is-active', b.dataset.lang === lang.value);
    });
    root.querySelectorAll('.theme-id').forEach(function (s) {
      s.textContent = themeIds[theme.value];
    });
    history.replaceState(null, '', '#' + theme.value + '/' + lang.value);
  }
  var hash = location.hash.slice(1).split('/');
  if (Object.hasOwn(themeIds, hash[0])) theme.value = hash[0];
  if (lang.querySelector('option[value="' + hash[1] + '"]')) lang.value = hash[1];
  theme.onchange = lang.onchange = render;
  render();
})();
</script>|}
    theme_css
    (options (List.map fst themes))
    (options (List.map (fun (lang, _, _) -> lang) languages))
    samples snippets theme_ids

let playground_page =
  {
    source_name = "playground";
    output_name = "playground.html";
    label = "Playground";
    section = Guide;
    content = `Html playground_html;
  }

