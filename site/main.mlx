let sidebar_link ~page ~current () =
  if page.output_name = current.output_name then
    <li>
      <a
        class_="doc-sidebar__link doc-sidebar__link--active"
        aria_current=`page
        href=page.output_name>
        <span class_="doc-sidebar__label">(JSX.string page.label)</span>
      </a>
    </li>
  else
    <li>
      <a class_="doc-sidebar__link" href=page.output_name>
        <span class_="doc-sidebar__label">(JSX.string page.label)</span>
      </a>
    </li>

let sidebar_group ~heading ~section ~pages ~current () =
  let items =
    pages
    |> List.filter (fun page -> page.section = section)
    |> List.map (fun page -> sidebar_link ~page ~current ())
  in
  <div class_="doc-sidebar__group">
    <h2 class_="doc-sidebar__heading">(JSX.string heading)</h2>
    <ul class_="doc-sidebar__list">(JSX.list items)</ul>
  </div>

let sidebar ~pages ~current () =
  <aside class_="doc-sidebar" id="doc-sidebar" aria_label="Documentation">
    <div class_="doc-sidebar__inner">
      <sidebar_group heading="Guides" section=Guide pages current />
      <sidebar_group heading="API" section=Api pages current />
    </div>
  </aside>

let hamburger_button () =
  <label
    class_="nav-hamburger"
    for_="nav-toggle"
    aria_label="Toggle navigation"
    title="Toggle navigation">
    <span class_="nav-hamburger__bar" aria_hidden=true />
    <span class_="nav-hamburger__bar" aria_hidden=true />
    <span class_="nav-hamburger__bar" aria_hidden=true />
  </label>

let theme_init_script =
  {|
(function () {
  try {
    var theme = localStorage.getItem("ochre.docs.theme");
    var resolved =
      theme === "light" || theme === "dark"
        ? theme
        : window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
    document.documentElement.setAttribute("data-doc-theme", resolved);
  } catch (_error) {}
})();
|}

let page ~pages ~current () =
  let article_html =
    match current.content with
    | `Markdown markdown ->
        markdown_body ~pages ~current markdown
    | `Html html ->
        html
  in
  let page_title = current.label ^ " - ochre documentation" in
  <html lang="en">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>(JSX.string page_title)</title>
      <meta name="description" content="ochre documentation" />
      <script>(JSX.unsafe theme_init_script)</script>
      <link rel="stylesheet" href="assets/fonts.css" />
      <style>(JSX.unsafe doc_theme_css)</style>
      <link rel="stylesheet" href="assets/index.css" />
      <script src="assets/index.js" defer=true />
    </head>
    <body>
      <a class_="skip-link" href="#main-content">
        (JSX.string "Skip to content")
      </a>
      <input
        id="nav-toggle" class_="nav-toggle" type_=`checkbox aria_hidden=true
      />
      <label class_="nav-backdrop" for_="nav-toggle" aria_hidden=true />
      <header class_="site-header">
        <div class_="site-header__inner">
          <div class_="site-header__leading">
            <hamburger_button />
            <a class_="site-brand" href="index.html">
              <span class_="site-brand__name">(JSX.string "ochre")</span>
            </a>
            <a
              target=`_blank
              rel="noopener noreferrer"
              class_="site-brand__github"
              href=repo_url
              aria_label="Open ochre GitHub repository"
              title="GitHub repository">
              <github_icon />
            </a>
          </div>
          <div class_="site-controls">
            <button
              class_="theme-toggle"
              type_=`button
              dataDocThemeToggle=""
              aria_label="Toggle color theme"
              title="Toggle color theme">
              <span class_="theme-toggle__sun" aria_hidden=true>"✹"</span>
              <span class_="theme-toggle__moon" aria_hidden=true>"⏾"</span>
            </button>
          </div>
        </div>
      </header>
      <div class_="doc-shell">
        <sidebar pages current />
        <main id="main-content" class_="doc-main">
          <article class_="doc-prose">(JSX.unsafe article_html)</article>
        </main>
      </div>
    </body>
  </html>

let load_pages api_sources =
  let open Eff in
  let read path = read_file ~snapshot:true ~on:`Source path in
  let* readme = read readme_source in
  let* cli = read cli_source in
  let rec collect acc = function
    | [] ->
        return (Stdlib.List.rev acc)
    | source :: rest ->
        let* markdown = read source in
        collect (api_page (basename_exn source) markdown :: acc) rest
  in
  let+ api_pages = collect [] api_sources in
  let guide source_name output_name label markdown =
    {
      source_name;
      output_name;
      label;
      section = Guide;
      content = `Markdown markdown;
    }
  in
  [
    guide "README.md" "index.html" "Overview" readme;
    guide "cli.md" "cli.html" "CLI" cli;
    playground_page;
  ]
  @ api_pages

let copy_assets cache =
  let open Eff in
  let* files =
    read_directory ~on:`Source ~only:`Files
      ~where:(Path.one_of_extensions [ "css"; "js"; "woff2" ])
      assets_dir
  in
  let rec copy_all cache = function
    | [] ->
        return cache
    | source :: rest ->
        let* cache = Action.copy_file ~into:target_assets_dir source cache in
        copy_all cache rest
  in
  copy_all cache files

let write_pages pages source_files cache =
  let open Eff in
  let deps = Deps.from_list (Path.rel [ "site"; "main.mlx" ] :: source_files) in
  let rec write_all cache = function
    | [] ->
        return cache
    | current :: rest ->
        let target = Path.(target_dir / current.output_name) in
        let task =
          Task.make deps (fun () ->
              Eff.return (JSX.render <page pages current />)
          )
        in
        let* cache = Action.Static.write_file target task cache in
        write_all cache rest
  in
  write_all cache pages

(* Ochre.md first, then its submodules in alphabetical order. *)
let compare_api left right =
  String.compare
    (String.lowercase_ascii (api_label (basename_exn left)))
    (String.lowercase_ascii (api_label (basename_exn right)))

let process_all () =
  let open Eff in
  let* api_sources =
    read_directory ~on:`Source ~only:`Files ~where:is_api_source api_dir
  in
  if api_sources = [] then
    invalid_arg "No markdown files found. Run `dune build @doc-markdown` first.";
  let api_sources = Stdlib.List.sort compare_api api_sources in
  let* pages = load_pages api_sources in
  let source_files = readme_source :: cli_source :: api_sources in
  Action.with_cache ~on:`Source cache_file (fun cache ->
      let* cache = write_pages pages source_files cache in
      let* cache = copy_assets cache in
      Action.remove_residuals ~target:target_dir cache
  )

let usage = "Usage: main.exe build | serve [--port PORT]"

let () =
  match List.tl (Array.to_list Sys.argv) with
  | [ "build" ] ->
      Yocaml_unix.run ~level:`Info process_all
  | [ "serve" ] ->
      Yocaml_unix.serve ~level:`Info ~target:target_dir ~port:8080 process_all
  | [ "serve"; "--port"; value ] -> (
      match int_of_string_opt value with
      | Some port when port > 0 && port < 65536 ->
          Yocaml_unix.serve ~level:`Info ~target:target_dir ~port process_all
      | _ ->
          prerr_endline usage;
          exit 2
    )
  | _ ->
      prerr_endline usage;
      exit 2
