(rule
 (enabled_if %{env:DOCS_SITE=false})
 (target main.ml)
 (action
  (with-stdout-to
   %{target}
   (run mlx-pp %{dep:main.mlx}))))

(rule
 (enabled_if %{env:DOCS_SITE=false})
 (target load_path.ml)
 (action
  (with-stdout-to
   %{target}
   (progn
    (echo "let ochre = {|%{cmi:../lib/ochre}|}\n")
    (echo "let tm_grammars = {|%{lib:tm-grammars:tm_grammars.cmi}|}\n")
    (echo
     "let tm_grammar_ocaml = {|%{lib:tm-grammars.ocaml:tm_grammar_ocaml.cmi}|}\n")))))

(executable
 (name main)
 (enabled_if %{env:DOCS_SITE=false})
 (libraries
  yocaml
  yocaml_unix
  ochre
  ochre-merlin
  tm-grammars
  omd
  str
  html_of_jsx)
 (preprocess
  (pps html_of_jsx.ppx)))
