(rule
 (enabled_if %{env:DOCS_SITE=false})
 (target main.ml)
 (action
  (with-stdout-to
   %{target}
   (run mlx-pp %{dep:main.mlx}))))

(executable
 (name main)
 (enabled_if %{env:DOCS_SITE=false})
 (libraries yocaml yocaml_unix ochre tm-grammars omd str html_of_jsx)
 (preprocess
  (pps html_of_jsx.ppx)))
