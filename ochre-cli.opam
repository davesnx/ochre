depends: [
  "dune" {>= "3.22"}
  "ocaml" {>= "4.14.0"}
  "ochre"
  "tm-grammars" {>= "2.1.0~dev"}
  "cmdliner" {>= "1.1.0"}
  "dune-build-info"
  "ezjsonm" {with-test}
  "alcotest" {with-test}
  "odoc" {>= "3.2.0" & with-doc}
]
build: [
  ["dune" "subst"] {dev}
