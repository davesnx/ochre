(rule
 (targets test_html.ml test_html_dual_theme.ml test_svg.ml)
 (deps test_html.mlx test_html_dual_theme.mlx test_svg.mlx)
 (action
  (progn
   (with-stdout-to
    test_html.ml
    (run mlx-pp %{dep:test_html.mlx}))
   (with-stdout-to
    test_html_dual_theme.ml
    (run mlx-pp %{dep:test_html_dual_theme.mlx}))
   (with-stdout-to
    test_svg.ml
    (run mlx-pp %{dep:test_svg.mlx})))))

(test
 (name test_ochre)
 (libraries ochre alcotest unix tm-grammars))

(executables
 (names test_html test_html_dual_theme test_svg)
 (libraries ochre unix tm-grammars html_of_jsx tiny_httpd)
 (preprocess
  (pps html_of_jsx.ppx)))

(executables
 (names test_latex test_ansi test_tokens)
 (libraries ochre unix tm-grammars))

(rule
 (target test_latex.tex)
 (deps test_latex.exe)
 (action
  (with-stdout-to
   %{target}
   (run %{dep:test_latex.exe}))))

; Each preview below is regenerated into a scratch `.gen` file and diffed
; against the committed preview as part of `@runtest`, so a rendering change
; that would leave a committed preview stale fails the build instead of
; passing silently. Run `dune build @runtest --auto-promote` to update a
; preview after an intentional rendering change.

(rule
 (target latex-preview.tex.gen)
 (deps test_latex.exe)
 (action
  (with-stdout-to
   %{target}
   (run %{dep:test_latex.exe}))))

(rule
 (alias runtest)
 (action
  (diff latex-preview.tex latex-preview.tex.gen)))

(rule
 (target ansi-preview.txt.gen)
 (deps test_ansi.exe)
 (action
  (with-stdout-to
   %{target}
   (run %{dep:test_ansi.exe}))))

(rule
 (alias runtest)
 (action
  (diff ansi-preview.txt ansi-preview.txt.gen)))

(rule
 (target tokens-preview.txt.gen)
 (deps test_tokens.exe)
 (action
  (with-stdout-to
   %{target}
   (run %{dep:test_tokens.exe}))))

(rule
 (alias runtest)
 (action
  (diff tokens-preview.txt tokens-preview.txt.gen)))

(rule
 (target svg-preview.svg.gen)
 (deps test_svg.exe)
 (action
  (with-stdout-to
   %{target}
   (run %{dep:test_svg.exe} --github-preview))))

(rule
 (alias runtest)
 (action
  (diff svg-preview.svg svg-preview.svg.gen)))

(rule
 (target html-preview.html.gen)
 (deps test_html.exe)
 (action
  (with-stdout-to
   %{target}
   (run %{dep:test_html.exe} --preview))))

(rule
 (alias runtest)
 (action
  (diff html-preview.html html-preview.html.gen)))

(rule
 (target html-dual-theme-preview.html.gen)
 (deps test_html_dual_theme.exe)
 (action
  (with-stdout-to
   %{target}
   (run %{dep:test_html_dual_theme.exe} --preview))))

(rule
 (alias runtest)
 (action
  (diff html-dual-theme-preview.html html-dual-theme-preview.html.gen)))
